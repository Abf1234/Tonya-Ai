# Django/backend settings. Copy this file to backend/.env for local development.
# Keep this file backend-only and never expose these values through Vite variables.
SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
DATABASE_URL=postgresql://truth_guardian:truth_guardian_dev@localhost:5432/truth_guardian
ALLOWED_HOSTS=localhost,127.0.0.1

OPENAI_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=

# Appwrite server-side integration. Keep the API key out of all VITE_* variables.
APPWRITE_ENDPOINT=
# Set true only for a local HTTP Appwrite endpoint; never in production.
APPWRITE_ALLOW_INSECURE_ENDPOINT=False
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
APPWRITE_STORAGE_BUCKET_ID=
APPWRITE_SERVER_API_KEY=

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
SECURE_COOKIES=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_PRELOAD=False
DATABASE_SSL_REQUIRE=False
