# Django/backend settings. Copy this file to backend/.env for local development.
# Keep all values here backend-only. Never copy secrets into VITE_* variables.

SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
DATABASE_URL=postgresql://truth_guardian:truth_guardian_dev@localhost:5432/truth_guardian
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_SSL_REQUIRE=False

# Browser origin and security policy. Use HTTPS production origins.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
SECURE_COOKIES=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Appwrite server-side integration. These values are optional while the public
# lookup/report slice is running. Never expose APPWRITE_SERVER_API_KEY to the browser.
APPWRITE_ENDPOINT=
# Set true only for a local HTTP Appwrite endpoint; never in production.
APPWRITE_ALLOW_INSECURE_ENDPOINT=False
APPWRITE_PROJECT_ID=
# Reserved for a future Appwrite table integration; PostgreSQL remains authoritative.
APPWRITE_DATABASE_ID=
# Private evidence bucket. Uploads remain disabled until a scanner is also configured.
APPWRITE_STORAGE_BUCKET_ID=
APPWRITE_SERVER_API_KEY=

# Evidence fail-closed policy. A supplied file is not reported as stored/scanned
# unless the server-side scanner and private storage integration are configured.
EVIDENCE_MAX_UPLOAD_BYTES=10485760
EVIDENCE_ALLOWED_CONTENT_TYPES=application/pdf,image/png,image/jpeg,image/webp
EVIDENCE_SCANNING_ENABLED=False
EVIDENCE_SCANNER=

# Optional backend-only Hugging Face natural-language layer. Keep disabled until
# a rotated token is configured in the server environment. Never use VITE_* here.
# The model is prompted to use only approved-source excerpts; it is not a
# verification decision engine.
HUGGINGFACE_ENABLED=False
HUGGINGFACE_TOKEN=
HUGGINGFACE_API_URL=https://router.huggingface.co/v1/chat/completions
HUGGINGFACE_MODEL=openai/gpt-oss-120b:fastest
HUGGINGFACE_TIMEOUT_SECONDS=15
HUGGINGFACE_MAX_TOKENS=450

# Reserved for a future Google Sheets operational export. It is not the report database.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=

# Optional worker infrastructure for future extraction/retry jobs. No current API
# response claims that these workers ran.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

LOG_LEVEL=INFO
