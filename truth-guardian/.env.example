# Copy to .env for local development. Never commit the real .env file.
# Backend secrets must never be copied into VITE_* variables or browser code.
SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
DATABASE_URL=postgresql://truth_guardian:truth_guardian_dev@localhost:5432/truth_guardian
DATABASE_SSL_REQUIRE=False

# Optional backend-only Hugging Face natural-language layer. Keep disabled until
# a rotated token is configured on the server. Never put this token in VITE_*.
HUGGINGFACE_ENABLED=False
HUGGINGFACE_TOKEN=
HUGGINGFACE_API_URL=https://router.huggingface.co/v1/chat/completions
HUGGINGFACE_MODEL=openai/gpt-oss-120b:fastest
HUGGINGFACE_TIMEOUT_SECONDS=15
HUGGINGFACE_MAX_TOKENS=450
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=

# Public Appwrite browser settings.
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_STORAGE_BUCKET_ID=

# Backend Appwrite settings. The server API key is a secret.
APPWRITE_ENDPOINT=
APPWRITE_ALLOW_INSECURE_ENDPOINT=False
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
APPWRITE_STORAGE_BUCKET_ID=
APPWRITE_SERVER_API_KEY=

# Evidence remains disabled until a real scanner and private storage boundary exist.
EVIDENCE_MAX_UPLOAD_BYTES=10485760
EVIDENCE_ALLOWED_CONTENT_TYPES=application/pdf,image/png,image/jpeg,image/webp
EVIDENCE_SCANNING_ENABLED=False
EVIDENCE_SCANNER=

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=truth_guardian
POSTGRES_USER=truth_guardian
POSTGRES_PASSWORD=truth_guardian_dev
SECURE_COOKIES=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
