# Copy to .env for local development. Never commit the real .env file.
SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
DATABASE_URL=postgresql://truth_guardian:truth_guardian_dev@localhost:5432/truth_guardian
OPENAI_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=

# Public Appwrite browser settings. Never put APPWRITE_SERVER_API_KEY in VITE_* variables.
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_STORAGE_BUCKET_ID=

# Backend Appwrite settings. The server API key is a secret.
APPWRITE_ENDPOINT=
APPWRITE_ALLOW_INSECURE_ENDPOINT=False
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
APPWRITE_STORAGE_BUCKET_ID=
APPWRITE_SERVER_API_KEY=

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=truth_guardian
POSTGRES_USER=truth_guardian
POSTGRES_PASSWORD=truth_guardian_dev
SECURE_COOKIES=False
SECURE_HSTS_PRELOAD=False
