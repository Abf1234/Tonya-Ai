# Public frontend settings only. Never place API keys, database, Google, or other secrets here.
VITE_API_URL=http://127.0.0.1:8000/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Appwrite public project settings. Use the regional API endpoint ending in /v1.
# Production builds require HTTPS; local development may use an HTTP endpoint.
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=
# Reserved for a future Appwrite table integration; PostgreSQL remains authoritative.
VITE_APPWRITE_DATABASE_ID=
# The bucket ID is public configuration; bucket permissions must remain private by default.
VITE_APPWRITE_STORAGE_BUCKET_ID=
